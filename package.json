{
  "name": "fork",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "smoke:models": "tsx scripts/smoke-models.ts",
    "e2e": "pnpm --filter web build && pnpm --filter web e2e && pnpm --filter web e2e:db",
    "db": "tsx scripts/db.ts",
    "fork": "tsx scripts/fork.ts",
    "smoke:documents": "tsx scripts/smoke-documents.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "tsx": "4.23.15",
    "pg": "8.23.0",
    "@types/pg": "8.23.1"
  },
  "dependencies": {
    "@fork/models": "workspace:*",
    "@fork/calc": "workspace:*",
    "@fork/pipeline": "workspace:*",
    "@fork/spec": "workspace:*",
    "@fork/db": "workspace:*",
    "drizzle-orm": "0.45.3",
    "@fork/setup": "workspace:*",
    "@fork/evals": "workspace:*",
    "@fork/jobs": "workspace:*"
  }
}
